<mxfile host="app.diagrams.net">
  <diagram name="Overall Flowchart" id="page-overall-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="PeerShare - Overall Flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Startup Dialog:&#10;enter peer name, TCP port,&#10;shared folder, download folder" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Try connecting to MySQL" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="260" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="DB reachable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5a" value="Use MySQL-backed history&#10;(status: Database connected)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5b" value="Fall back to in-memory history&#10;(status: Database unavailable)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Start FileShareServer (TCP)&#10;+ start PeerDiscovery (UDP)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="520" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Main window shown.&#10;Peer list refreshes every 2s" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="610" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="User action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="710" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s9a" value="Share File / Share Folder&#10;(JFileChooser -&gt; SharedFileRegistry)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s9b" value="Select peer -&gt; Refresh File List&#10;-&gt; Download Selected" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="820" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="See Module Flowchart:&#10;File Transfer &amp; Security" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="920" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="Log SUCCESS/FAILED/HASH_MISMATCH&#10;to transfer_history (or in-memory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="600" y="1020" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="App closed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="1120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s13" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="380" y="1230" width="140" height="50" as="geometry" />
        </mxCell>
