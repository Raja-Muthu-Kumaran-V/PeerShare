<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="page-architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PeerShare - System Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gui" value="PeerShareApp (Swing GUI)&#10;StartupDialog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="discovery" value="PeerDiscovery&#10;(UDP broadcast, port 9876)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="peer" value="Peer&#10;(id, name, host, tcpPort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="SharedFileRegistry&#10;(shared folder + picked files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="server" value="FileShareServer&#10;(TCP listener - sends files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="680" y="220" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client" value="FileShareClient&#10;(TCP client - requests/downloads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="980" y="220" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="transfertask" value="TransferTask&#10;(per-transfer worker + progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="830" y="320" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="crypto" value="CryptoUtil&#10;RSA-2048 key exchange + AES/CBC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hash" value="HashUtil&#10;SHA-256 integrity check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="980" y="400" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="Validation&#10;form + input checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="Repository&lt;T,ID&gt; (generic)&#10;-&gt; TransferHistoryRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dbconfig" value="DatabaseConfig&#10;(db.properties)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="MySQL / MariaDB&#10;transfer_history table" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
          <mxGeometry x="140" y="670" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="utils" value="Generic utilities:&#10;Pair&lt;A,B&gt;, Result&lt;T&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lan" value="LAN (other PeerShare instances)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lan" target="discovery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="discovery" target="peer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gui" target="discovery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gui" target="registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gui" target="server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gui" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="TCP" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="server" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="client" target="transfertask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="server" target="transfertask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="transfertask" target="crypto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="transfertask" target="hash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="gui" target="validation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="on every transfer" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="transfertask" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="repo" target="dbconfig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dbconfig" target="mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
