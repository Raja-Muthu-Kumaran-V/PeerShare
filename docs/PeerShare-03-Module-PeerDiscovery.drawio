<mxfile host="app.diagrams.net">
  <diagram name="Module - Peer Discovery" id="page-mod-discovery">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Module: Peer Discovery (UDP)" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="PeerDiscovery.start()&#10;opens UDP socket on port 9876" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Every 2s: broadcast&#10;'I am &lt;name&gt;@&lt;host&gt;:&lt;tcpPort&gt;'" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Listen thread: receive&#10;broadcast packets from LAN" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
