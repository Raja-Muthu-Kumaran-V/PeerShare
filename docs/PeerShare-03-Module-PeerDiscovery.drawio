          <mxGeometry x="180" y="380" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="Remove peer from registry" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="480" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="GUI timer (every 2s):&#10;refreshPeerList() updates&#10;'Discovered Peers' JList" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="240" height="70" as="geometry" />
